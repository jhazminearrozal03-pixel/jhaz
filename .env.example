DATABASE_URL="file:./dev.db"

# Team Task Checklist (Monday.com sync)
# Random secret used to sign checklist login session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""
# Monday.com API token (Admin > Profile > Developer > My Access Tokens), needs boards read/write scope
MONDAY_API_TOKEN=""
# Shared secret you choose; appended as ?secret=... to the webhook URL you register in Monday.com
MONDAY_WEBHOOK_SECRET=""
# The board being synced
MONDAY_BOARD_ID=""
# Column id of the status column that represents task completion (find via the board's API playground)
MONDAY_STATUS_COLUMN_ID=""
# Exact status label used for "done" / "not done" (defaults shown)
MONDAY_DONE_LABEL="Done"
MONDAY_TODO_LABEL="Working on it"
# Column id of the person/assignee column (defaults to "person")
MONDAY_PERSON_COLUMN_ID="person"
